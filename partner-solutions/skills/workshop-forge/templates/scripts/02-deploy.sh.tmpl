#!/usr/bin/env bash
# Deploy the reference-build metadata to the assigned org.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/scripts/lib/common.sh"
ORG="$(resolve_org "$@")"
[ -n "$ORG" ] || { fail "no org (pass --org <alias> or set ORG_ALIAS)"; exit 1; }
[ -d "$ROOT/{{REFERENCE_BUILD_PATH}}" ] || { fail "{{REFERENCE_BUILD_PATH}} not found"; exit 1; }
( cd "$ROOT/{{SFDX_PROJECT_DIR}}" && sf project deploy start --source-dir {{DEPLOY_SOURCE_DIR}} --target-org "$ORG" )
