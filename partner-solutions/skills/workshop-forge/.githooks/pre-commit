#!/bin/sh
# workshop-forge pre-commit hook — runs the validation suite; blocks on failure.
# Activate once: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 not found" >&2; exit 1; }

echo "Running skill validation..."
python3 "$root/tests/validate_skill.py"
status=$?
[ "$status" -ne 0 ] && echo "pre-commit: skill validation FAILED — commit aborted." >&2 && exit "$status"

echo "Running behavioral tests..."
python3 "$root/tests/test_scaffold.py"
status=$?
[ "$status" -ne 0 ] && echo "pre-commit: behavioral tests FAILED — commit aborted." >&2 && exit "$status"

echo "All checks passed."
exit 0
