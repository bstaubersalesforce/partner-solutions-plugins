#!/bin/sh
# Generated by skill-forge. Runs the skill validation suite; blocks the commit on failure.
root="$(git rev-parse --show-toplevel)"
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 not found" >&2; exit 1; }
python3 "$root/tests/validate_skill.py"
status=$?
[ "$status" -ne 0 ] && echo "pre-commit: skill validation FAILED — commit aborted." >&2
exit "$status"
